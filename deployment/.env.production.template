# ============================================================
# GymX — production .env for PythonAnywhere
# Copy this file to ".env" (rename it, remove ".production.template")
# inside your project folder on PythonAnywhere, then fill in the
# placeholders marked with <...>.
# NEVER commit this file to git or share it — it holds real secrets.
# ============================================================

DEBUG=False

# A fresh, random key generated for you — use it as-is, or generate
# your own with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=146j3q&#!3zse7i4zvv!u4he9&a=1c9yzp@fmp^e_n$bb7mw%$

# Replace YOURUSERNAME with your actual PythonAnywhere username
ALLOWED_HOSTS=YOURUSERNAME.pythonanywhere.com
SITE_URL=https://YOURUSERNAME.pythonanywhere.com

# ── Database ────────────────────────────────────────────────
# PythonAnywhere's built-in database is MySQL (Postgres needs a paid
# external service, so MySQL is the practical choice here).
# Create the database first: PythonAnywhere dashboard → "Databases" tab
# → set a MySQL password → create a database (its full name will look
# like "YOURUSERNAME$gymx").
DB_ENGINE=mysql
DB_NAME=YOURUSERNAME$gymx
DB_USER=YOURUSERNAME
DB_PASSWORD=<the MySQL password you set on the Databases tab>
DB_HOST=YOURUSERNAME.mysql.pythonanywhere-services.com
DB_PORT=3306

# ── Email (for OTP, receipts, reminders) ──────────────────────
# IMPORTANT: rotate the Gmail App Password before deploying — the one
# used during development was exposed to a third-party AI tool and
# must not be reused. Generate a fresh one at:
# https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<your gym's Gmail address>
EMAIL_HOST_PASSWORD=<new Gmail App Password — 16 chars, no spaces needed>
DEFAULT_FROM_EMAIL=GymX <noreply@gymx.com>

# ── SMS (optional — leave blank to disable SMS features) ──────
TWILIO_ACCOUNT_SID=<your real Twilio SID, or leave blank>
TWILIO_AUTH_TOKEN=<your real Twilio auth token, or leave blank>
TWILIO_PHONE_NUMBER=<your Twilio phone number, or leave blank>
